<?xml version="1.0" encoding="utf-8" ?>
<!-- Inicio de Facst Play TV: menú de pestañas arriba, portada a lo ancho y filas de contenido. -->
<component name="HomeScreen" extends="Group">
  <interface>
    <field id="event" type="assocarray" alwaysNotify="true" />
    <function name="focusScreen" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/HomeScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
  <children>
    <Rectangle id="base" width="1280" height="720" color="0x07060FFF" />
    <Poster id="placeholder" uri="pkg:/images/hero_brand.jpg" width="1280" height="600" opacity="0.55" />
    <Poster id="backdrop" width="1280" height="600" loadDisplayMode="scaleToZoom" loadWidth="1600" loadHeight="750" />
    <Poster id="heroFade" uri="pkg:/images/hero_fade_full.png" width="1280" height="600" />
    <Poster id="topShade" uri="pkg:/images/top_shade.png" width="1280" height="150" />

    <Group id="hero" translation="[64,0]">
      <Poster id="badge" uri="pkg:/images/pill_red.9.png" translation="[0,128]" width="104" height="24" />
      <Label id="badgeText" translation="[0,128]" width="104" height="24" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" text="DESTACADO">
        <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="12" />
      </Label>
      <Label id="kicker" translation="[118,128]" width="480" height="24" vertAlign="center" color="0xB4AECBFF">
        <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="14" />
      </Label>
      <Label id="title" translation="[0,160]" width="660" height="0" wrap="true" maxLines="2" lineSpacing="-6" color="0xF3F1FAFF">
        <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="40" />
      </Label>
      <Label id="meta" translation="[0,170]" width="660" height="24" color="0xB4AECBFF">
        <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="15" />
      </Label>
      <Label id="plot" translation="[0,200]" width="600" height="0" wrap="true" maxLines="2" lineSpacing="2" color="0xD6D1E8FF">
        <Font role="font" uri="pkg:/fonts/Poppins-Regular.ttf" size="15" />
      </Label>
      <Group id="btns" translation="[0,300]" />
      <Group id="dots" translation="[0,370]" />
    </Group>

    <Label id="status" translation="[64,480]" width="1100" height="80" wrap="true" color="0xB4AECBFF">
      <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="17" />
    </Label>

    <RowList id="rows" translation="[64,462]" itemComponentName="MaxCard" numRows="2"
      itemSize="[1216,186]" itemSpacing="[0,48]" rowItemSize="[[124,186]]" rowItemSpacing="[[14,0]]"
      showRowLabel="[true]" rowLabelColor="0xF3F1FAFF"
      focusBitmapUri="pkg:/images/ring_red.9.png" drawFocusFeedbackOnTop="true"
      rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="fixedFocus">
      <Font role="rowLabelFont" uri="pkg:/fonts/Poppins-Bold.ttf" size="19" />
    </RowList>

    <Poster id="navLogo" uri="pkg:/images/logo_nav.png" translation="[48,18]" width="150" height="76" loadDisplayMode="scaleToFit" />
    <Group id="rail" translation="[222,36]">
      <Group id="railItems" />
    </Group>
    <Label id="clock" translation="[1000,26]" width="232" height="34" horizAlign="right" color="0xF3F1FAFF">
      <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="26" />
    </Label>
    <Label id="date" translation="[900,60]" width="332" height="20" horizAlign="right" color="0x8E88A8FF">
      <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="12" />
    </Label>
    <Poster id="accPill" uri="pkg:/images/btn_glass.9.png" translation="[980,86]" width="250" height="30" />
    <Rectangle id="accDot" translation="[996,97]" width="8" height="8" color="0x38D0FFFF" />
    <Label id="accText" translation="[1012,86]" width="0" height="30" vertAlign="center" color="0xD6D1E8FF">
      <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="12" />
    </Label>
    <Timer id="tick" duration="15" repeat="true" />
    <Timer id="infoTimer" duration="0.45" repeat="false" />
    <Timer id="rotTimer" duration="9" repeat="true" />
  </children>
</component>
