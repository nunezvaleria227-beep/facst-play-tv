<?xml version="1.0" encoding="utf-8" ?>
<!-- Inicio de Facst Play TV: menú lateral, portada grande con lo destacado y filas de contenido. -->
<component name="HomeScreen" extends="Group">
  <interface>
    <field id="event" type="assocarray" alwaysNotify="true" />
    <function name="focusScreen" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/HomeScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
  <children>
    <Rectangle id="base" width="1280" height="720" color="0x07060FFF" />
    <Poster id="placeholder" uri="pkg:/images/rail_mark.png" translation="[760,96]" width="420" height="264" opacity="0.07" loadDisplayMode="scaleToFit" />
    <Poster id="backdrop" translation="[380,0]" width="900" height="506" loadDisplayMode="scaleToZoom" loadWidth="1350" loadHeight="759" />
    <Poster id="heroFade" uri="pkg:/images/hero_fade.png" translation="[380,0]" width="900" height="506" />
    <Poster id="topShade" uri="pkg:/images/top_shade.png" translation="[380,0]" width="900" height="120" />

    <Group id="hero" translation="[120,0]">
      <Poster id="badge" uri="pkg:/images/pill_red.9.png" translation="[0,72]" width="104" height="24" />
      <Label id="badgeText" translation="[0,72]" width="104" height="24" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" text="DESTACADO">
        <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="12" />
      </Label>
      <Label id="kicker" translation="[118,72]" width="480" height="24" vertAlign="center" color="0xB4AECBFF">
        <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="14" />
      </Label>
      <Label id="title" translation="[0,104]" width="660" height="0" wrap="true" maxLines="2" lineSpacing="-6" color="0xF3F1FAFF">
        <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="40" />
      </Label>
      <Label id="meta" translation="[0,170]" width="660" height="24" color="0xB4AECBFF">
        <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="15" />
      </Label>
      <Label id="plot" translation="[0,200]" width="600" height="0" wrap="true" maxLines="3" lineSpacing="2" color="0xD6D1E8FF">
        <Font role="font" uri="pkg:/fonts/Poppins-Regular.ttf" size="15" />
      </Label>
      <Group id="btns" translation="[0,300]" />
      <Group id="dots" translation="[0,370]" />
    </Group>

    <Label id="status" translation="[120,470]" width="1100" height="80" wrap="true" color="0xB4AECBFF">
      <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="17" />
    </Label>

    <RowList id="rows" translation="[120,450]" itemComponentName="MaxCard" numRows="2"
      itemSize="[1160,186]" itemSpacing="[0,48]" rowItemSize="[[124,186]]" rowItemSpacing="[[14,0]]"
      showRowLabel="[true]" rowLabelColor="0xF3F1FAFF"
      focusBitmapUri="pkg:/images/ring_red.9.png" drawFocusFeedbackOnTop="true"
      rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="fixedFocus">
      <Font role="rowLabelFont" uri="pkg:/fonts/Poppins-Bold.ttf" size="19" />
    </RowList>

    <Poster id="accPill" uri="pkg:/images/btn_glass.9.png" translation="[700,30]" width="250" height="34" />
    <Rectangle id="accDot" translation="[716,43]" width="8" height="8" color="0x3DDC84FF" />
    <Label id="accText" translation="[732,30]" width="0" height="34" vertAlign="center" color="0xD6D1E8FF">
      <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="13" />
    </Label>
    <Label id="clock" translation="[980,24]" width="260" height="34" horizAlign="right" color="0xF3F1FAFF">
      <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="26" />
    </Label>
    <Label id="date" translation="[880,58]" width="360" height="20" horizAlign="right" color="0x8E88A8FF">
      <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="12" />
    </Label>

    <Group id="rail">
      <Rectangle id="railPanel" width="250" height="720" color="0x0C0B16F7" visible="false" />
      <Rectangle id="railPanelLine" translation="[250,0]" width="1" height="720" color="0x2C2846FF" visible="false" />
      <Rectangle id="railBg" width="84" height="720" color="0x0C0B16FF" />
      <Rectangle id="railLine" translation="[84,0]" width="1" height="720" color="0x221E37FF" />
      <Poster id="railMark" uri="pkg:/images/rail_mark.png" translation="[10,30]" width="64" height="40" loadDisplayMode="scaleToFit" />
      <Group id="railItems" />
    </Group>

    <Timer id="tick" duration="15" repeat="true" />
    <Timer id="infoTimer" duration="0.45" repeat="false" />
    <Timer id="rotTimer" duration="9" repeat="true" />
  </children>
</component>
