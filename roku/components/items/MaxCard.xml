<?xml version="1.0" encoding="utf-8" ?>
<!-- Tarjeta de las filas del inicio: cartel (película/serie, con barra de avance) o canal (logo y nombre). -->
<component name="MaxCard" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="width" type="float" onChange="layout" />
    <field id="height" type="float" onChange="layout" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/items/MaxCard.brs" />
  <children>
    <Poster id="bg" uri="pkg:/images/card_bg.9.png" />
    <Label id="fallback" wrap="true" horizAlign="center" vertAlign="center" color="0x8E88A8FF">
      <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="13" />
    </Label>
    <Poster id="art" loadDisplayMode="scaleToZoom" />
    <Poster id="logo" loadDisplayMode="scaleToFit" />
    <Poster id="shade" uri="pkg:/images/card_shade.png" />
    <Label id="name" vertAlign="center" color="0xF3F1FAFF">
      <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="13" />
    </Label>
    <Rectangle id="progBg" color="0xFFFFFF40" />
    <Rectangle id="progFill" color="0x8B3DF0FF" />
    <Poster id="corners" uri="pkg:/images/card_round.9.png" />
  </children>
</component>
